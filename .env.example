# Slack Credentials
# Option 1: Incoming Webhook (Simplest setup)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T00000000/B00000000/XXXXXXXXXXXXXXXXXXXXXXXX

# Option 2: Slack Web API (Alternative setup)
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_CHANNEL_ID=C0123456789

# App Configuration
# Preferred timezone to display match kickoff times (IANA timezone format)
USER_TIMEZONE=America/New_York

# Set to true to print the formatted message to console instead of posting to Slack
DRY_RUN=false
